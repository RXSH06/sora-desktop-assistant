# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.0-flash-exp
GEMINI_VOICE=Puck

# Google OAuth Configuration (for Gmail & Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8089/oauth2callback

# Wake Word Settings
WAKE_WORD="hey sora"
WAKE_WORD_ENABLED=true
WAKE_WORD_SENSITIVITY=0.6

# Application Behavior
APP_ALWAYS_ON_TOP=true
APP_OPACITY=0.95
CHARACTER_SIZE=180
SPEECH_BUBBLE_ENABLED=true
AUTOSTART_ON_BOOT=false
EMERGENCY_STOP_SHORTCUT="Ctrl+Shift+Escape"
ACTIVATE_SHORTCUT="Ctrl+Space"
